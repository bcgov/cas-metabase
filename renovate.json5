{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>bcgov/renovate-config#2026.8.18',
    'customManagers:helmChartYamlAppVersions',
  ],
  enabledManagers: [
    'helm-values',
    'custom.regex',
    'github-actions',
  ],
  labels: [
    'dependencies',
  ],
  automerge: false,
  platformAutomerge: false,
  dependencyDashboard: {
    enabled: false,
  },
  updateNotScheduled: true,
  packageRules: [
    {
      description: 'Metabase — bump values.yaml tag and Chart.yaml appVersion',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'metabase/metabase',
      ],
      groupName: 'metabase',
      allowedVersions: '/^v\\d+\\.\\d+\\.\\d+(\\.\\d+)?$/',
      minimumReleaseAge: '7 days',
      bumpVersions: [
        {
          name: 'cas-metabase chart version',
          filePatterns: [
            'helm/cas-metabase/Chart.yaml',
          ],
          matchStrings: [
            'version:\\s*(?<version>[^\\s]+)',
          ],
          bumpType: '{{#if isPatch}}patch{{else}}minor{{/if}}',
        },
      ],
    },
  ],
}
